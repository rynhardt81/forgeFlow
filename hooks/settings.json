{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_note": "Claude Forge v4 — session context, task-registry consistency, and advisory validators. Never blocks. No hook spawns an LLM subprocess.",
  "_deny_note": "Block explicit Read/cat/head/grep on paths that waste context: build outputs, caches, generated code, minified bundles. .gitignored paths are already excluded by built-in search; these deny rules cover paths that show up in greps when checked in OR when an explicit cat/head fires. Recursive searches still match inside these paths — deny only blocks explicit file opens. dist/ and build/ are denied BY EXTENSION, not wholesale: a blanket Read(./**/dist/**) also blocked node_modules/next/dist/docs/, which is documentation and none of the four things this note says the rule exists to block. Cache dirs keep their blanket rule because they never carry docs.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session/session-context.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge/consistency-banner.py\" --fix --summary",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session/session-context.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge/consistency-banner.py\" --fix --summary",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session/session-context.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge/consistency-banner.py\" --fix --summary",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/context/user-prompt-submit.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validation/pr-skill-reminder.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validation/validate-edit.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge/consistency-banner.py\" --fix --json",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge/isa-reflection-emit.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge/checkpoint-nudge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session/session-end-cleanup.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [],
    "Stop": []
  },
  "permissions": {
    "allow": [
      "Read(.claude/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Read(docs/tasks/**)",
      "Edit(docs/tasks/**)",
      "Write(docs/tasks/**)",
      "Read(docs/epics/**)",
      "Read(docs/project-memory/**)",
      "Edit(docs/project-memory/**)",
      "Write(docs/project-memory/**)",
      "Read(daily/**)",
      "Write(daily/**)",
      "Bash(awk *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(chmod -R *)",
      "Bash(chown *)",
      "Bash(npm publish *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(kubectl delete *)",
      "Bash(ssh *)"
    ],
    "deny": [
      "Read(./**/dist/**/*.js)",
      "Read(./**/dist/**/*.cjs)",
      "Read(./**/dist/**/*.mjs)",
      "Read(./**/dist/**/*.css)",
      "Read(./**/build/**/*.js)",
      "Read(./**/build/**/*.cjs)",
      "Read(./**/build/**/*.mjs)",
      "Read(./**/build/**/*.css)",
      "Read(./**/.next/**)",
      "Read(./**/.nuxt/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/.parcel-cache/**)",
      "Read(./**/.vite/**)",
      "Read(./**/.svelte-kit/**)",
      "Read(./**/.angular/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.pytest_cache/**)",
      "Read(./**/.mypy_cache/**)",
      "Read(./**/.ruff_cache/**)",
      "Read(./**/.tox/**)",
      "Read(./**/.venv/**)",
      "Read(./**/venv/**)",
      "Read(./**/htmlcov/**)",
      "Read(./**/coverage/**)",
      "Read(./**/*.generated.*)",
      "Read(./**/*.min.js)",
      "Read(./**/*.min.css)",
      "Read(./**/*.map)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(find *)"
    ]
  },
  "_precompact_stop_note": "PreCompact/Stop are deliberately EMPTY arrays, not absent: the installer's per-event merge overwrites consumer settings per event, so these clear the v3 memory-capture/claude-md-reflect wiring on upgrade. Do not remove.",
  "_permissions_note": "Bash rules: read-only commands (rg/fd/grep/ls/cat/head/tail/git+gh read-only subcommands) are auto-allowed by Claude Code and need no entry. `ask` gates destructive commands even in permissive modes, where a default prompt would not fire. Interpreters (python3/node/bun/npx) are deliberately absent from `allow`: patterns are prefix matches, so `Bash(python3 script.py *)` would also match `python3 script.py && rm -rf ~`. `find` is denied per the house rule that bare `find` has hung this machine — use `fd`. Override per-project in .claude/settings.local.json."
}
